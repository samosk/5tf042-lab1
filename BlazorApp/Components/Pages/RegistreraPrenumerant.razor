@page "/registrera"
@rendermode InteractiveServer
@inject PrenumerantApiClient ApiClient
@inject NavigationManager Nav

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="card-title mb-4">Registrera prenumerant</h2>

                    @if (sparad)
                    {
                        <div class="alert alert-success">Prenumerant registrerad!</div>
                    }

                    @if (felmeddelande is not null)
                    {
                        <div class="alert alert-danger">@felmeddelande</div>
                    }

                    <EditForm Model="formModel" OnValidSubmit="Spara" FormName="registrera-prenumerant">
                        <DataAnnotationsValidator />
                        <ValidationSummary class="text-danger" />

                        <div class="mb-3">
                            <label class="form-label">Personnummer</label>
                            <InputText @bind-Value="formModel.Personnummer" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Förnamn</label>
                            <InputText @bind-Value="formModel.Fornamn" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Efternamn</label>
                            <InputText @bind-Value="formModel.Efternamn" class="form-control" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Utdelningsadress</label>
                            <InputText @bind-Value="formModel.Utdelningsadress" class="form-control" />
                        </div>
                        <div class="row mb-3">
                            <div class="col-4">
                                <label class="form-label">Postnummer</label>
                                <InputText @bind-Value="formModel.Postnummer" class="form-control" />
                            </div>
                            <div class="col-8">
                                <label class="form-label">Ort</label>
                                <InputText @bind-Value="formModel.Ort" class="form-control" />
                            </div>
                        </div>
                        <div class="mb-4">
                            <label class="form-label">Telefonnummer</label>
                            <InputText @bind-Value="formModel.Telefonnummer" class="form-control" />
                        </div>

                        <button type="submit" class="btn btn-primary w-100">Registrera</button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private PrenumerantDto formModel = new();
    private bool sparad = false;
    private string? felmeddelande;

    private async Task Spara()
    {
        sparad = false;
        felmeddelande = null;

        try
        {
            await ApiClient.CreateAsync(formModel);
            sparad = true;
            formModel = new();
        }
        catch (Exception ex)
        {
            felmeddelande = $"Något gick fel: {ex.Message}";
        }
    }
}