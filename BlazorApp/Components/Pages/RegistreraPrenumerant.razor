@page "/registrera"
@rendermode InteractiveServer
@inject PrenumerantApiClient ApiClient
@inject NavigationManager Nav

<h2>Registrera prenumerant</h2>

@if (sparad)
{
    <div style="color: green">Prenumerant registrerad!</div>
}

@if (felmeddelande is not null)
{
    <div style="color: red">@felmeddelande</div>
}

<EditForm Model="formModel" OnValidSubmit="Spara" FormName="registrera-prenumerant">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div>
        <label>Personnummer</label>
        <InputText @bind-Value="formModel.Personnummer" />
    </div>
    <div>
        <label>Förnamn</label>
        <InputText @bind-Value="formModel.Fornamn" />
    </div>
    <div>
        <label>Efternamn</label>
        <InputText @bind-Value="formModel.Efternamn" />
    </div>
    <div>
        <label>Utdelningsadress</label>
        <InputText @bind-Value="formModel.Utdelningsadress" />
    </div>
    <div>
        <label>Postnummer</label>
        <InputText @bind-Value="formModel.Postnummer" />
    </div>
    <div>
        <label>Ort</label>
        <InputText @bind-Value="formModel.Ort" />
    </div>
    <div>
        <label>Telefonnummer</label>
        <InputText @bind-Value="formModel.Telefonnummer" />
    </div>

    <button type="submit">Registrera</button>
</EditForm>

@code {
    private PrenumerantDto formModel = new();
    private bool sparad = false;
    private string? felmeddelande;

    private async Task Spara()
    {
        sparad = false;
        felmeddelande = null;

        try
        {
            await ApiClient.CreateAsync(formModel);
            sparad = true;
            formModel = new();
        }
        catch (Exception ex)
        {
            felmeddelande = $"Något gick fel: {ex.Message}";
        }
    }
}