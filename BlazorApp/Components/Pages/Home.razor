@page "/"
@rendermode InteractiveServer
@inject AnnonsContext Db
@using Microsoft.EntityFrameworkCore

<h2 class="mb-4">Annonser</h2>

@if (laddar)
{
    <p class="text-muted fst-italic">Laddar annonser...</p>
}
else if (annonser.Count == 0)
{
    <p class="text-muted text-center py-4">Inga annonser hittades.</p>
}
else
{
    <p class="text-muted small mb-3">@annonser.Count annons@(annonser.Count == 1 ? "" : "er") hittades</p>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var ad in annonser)
        {
            <div class="col">
                <div class="card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h5 class="card-title mb-0">@ad.Rubrik</h5>
                            @if (ad.Annonsor.Typ == "foretag")
                            {
                                <span class="badge bg-primary ms-2">Företag</span>
                            }
                            else
                            {
                                <span class="badge bg-success ms-2">Prenumerant</span>
                            }
                        </div>

                        <p class="card-text text-muted flex-grow-1">@ad.Innehall</p>

                        <hr class="my-2" />

                        <div class="d-flex justify-content-between align-items-end">
                            <div>
                                <div class="small text-muted">Varupris: <strong class="text-dark">@ad.Varupris kr</strong></div>
                                <div class="small text-muted">Annonspris: <strong class="text-dark">@ad.Annonspris kr</strong></div>
                            </div>
                            <div class="text-end">
                                <div class="small fw-semibold">@ad.Annonsor.Namn</div>
                                @if (ad.Annonsor.Typ == "foretag" && ad.Annonsor.Organisationsnummer is not null)
                                {
                                    <div class="small text-muted">Org.nr: @ad.Annonsor.Organisationsnummer</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@code {
    private List<Ad> annonser = new();
    private bool laddar = true;

    protected override async Task OnInitializedAsync()
    {
        annonser = await Db.Ads
            .Include(a => a.Annonsor)
            .OrderBy(a => a.Rubrik)
            .ToListAsync();
        laddar = false;
    }
}