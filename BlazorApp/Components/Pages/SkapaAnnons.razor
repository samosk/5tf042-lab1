@page "/skapa-annons"
@rendermode InteractiveServer
@inject PrenumerantApiClient ApiClient
@inject AnnonsService AnnonsService
@inject NavigationManager Nav

<h2>Skapa annons</h2>

@if (sparad)
{
    <p style="color: green">Annonsen har sparats!</p>
}

@if (felmeddelande is not null)
{
    <p style="color: red">@felmeddelande</p>
}

<div>
    <label>
        <input type="radio" name="typ" value="prenumerant" checked="@(annonstyp == "prenumerant")"
               @onchange="@(() => ValjTyp("prenumerant"))" />
        Prenumerant
    </label>
    <label>
        <input type="radio" name="typ" value="foretag" checked="@(annonstyp == "foretag")"
               @onchange="@(() => ValjTyp("foretag"))" />
        Företag
    </label>
</div>

@if (annonstyp == "prenumerant")
{
    <div>
        <label>Prenumerationsnummer</label>
        <input type="number" @bind="prenumerationsnummer" />
        <button @onclick="HamtaPrenumerant">Hämta uppgifter</button>
    </div>

    @if (hittadPrenumerant is not null)
    {
        <p style="color: green">Uppgifter hämtade!</p>
        <p>@hittadPrenumerant.Fornamn @hittadPrenumerant.Efternamn</p>
        <p>@hittadPrenumerant.Utdelningsadress, @hittadPrenumerant.Postnummer @hittadPrenumerant.Ort</p>
        <p>@hittadPrenumerant.Telefonnummer</p>
    }
    else if (soktePrenumerant)
    {
        <p style="color: red">Ingen prenumerant hittades med det numret.</p>
    }
}

@if (annonstyp == "foretag")
{
    <EditForm Model="foretagsModel" FormName="foretag-uppgifter">
        <div>
            <label>Företagsnamn</label>
            <InputText @bind-Value="foretagsModel.Namn" />
        </div>
        <div>
            <label>Organisationsnummer</label>
            <InputText @bind-Value="foretagsModel.Organisationsnummer" />
        </div>
        <div>
            <label>Telefonnummer</label>
            <InputText @bind-Value="foretagsModel.Telefonnummer" />
        </div>
        <div>
            <label>Utdelningsadress</label>
            <InputText @bind-Value="foretagsModel.Utdelningsadress" />
        </div>
        <div>
            <label>Postnummer</label>
            <InputText @bind-Value="foretagsModel.Postnummer" />
        </div>
        <div>
            <label>Ort</label>
            <InputText @bind-Value="foretagsModel.Ort" />
        </div>
        <div>
            <label>Fakturaadress</label>
            <InputText @bind-Value="foretagsModel.FakturaAdress" />
        </div>
        <div>
            <label>Fakturapostnummer</label>
            <InputText @bind-Value="foretagsModel.FakturaPostnummer" />
        </div>
        <div>
            <label>Fakturaort</label>
            <InputText @bind-Value="foretagsModel.FakturaOrt" />
        </div>
    </EditForm>
}

@if (annonstyp is not null && (annonstyp == "foretag" || hittadPrenumerant is not null))
{
    <EditForm Model="annonsForm" OnValidSubmit="Spara" FormName="skapa-annons">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div>
            <label>Rubrik</label>
            <InputText @bind-Value="annonsForm.Rubrik" />
        </div>
        <div>
            <label>Innehåll</label>
            <InputTextArea @bind-Value="annonsForm.Innehall" />
        </div>
        <div>
            <label>Varupris (kr)</label>
            <InputNumber @bind-Value="annonsForm.Varupris" />
        </div>
        <p>Annonspris: @(annonstyp == "prenumerant" ? "0 kr (prenumerantrabatt)" : "40 kr")</p>

        <button type="submit">Spara annons</button>
    </EditForm>
}

@code {
    private string? annonstyp;
    private int prenumerationsnummer;
    private PrenumerantDto? hittadPrenumerant;
    private bool soktePrenumerant = false;
    private string? felmeddelande;
    private bool sparad = false;

    private AdFormModel annonsForm = new();
    private Annonsor foretagsModel = new() { Typ = "foretag" };

    private void ValjTyp(string typ)
    {
        annonstyp = typ;
        hittadPrenumerant = null;
        soktePrenumerant = false;
        felmeddelande = null;
        sparad = false;
    }


    private async Task HamtaPrenumerant()
    {
        hittadPrenumerant = null;
        soktePrenumerant = false;

        if (prenumerationsnummer <= 0) return;

        hittadPrenumerant = await ApiClient.GetByPrenumerantnummerAsync(prenumerationsnummer);
        soktePrenumerant = true;
    }

    private async Task Spara()
    {
        sparad = false;
        felmeddelande = null;

        try
        {
            Annonsor annonsor;

            if (annonstyp == "prenumerant" && hittadPrenumerant is not null)
            {
                annonsor = new Annonsor
                {
                    Typ = "prenumerant",
                    PreId = hittadPrenumerant.Id,
                    Namn = $"{hittadPrenumerant.Fornamn} {hittadPrenumerant.Efternamn}",
                    Telefonnummer = hittadPrenumerant.Telefonnummer,
                    Utdelningsadress = hittadPrenumerant.Utdelningsadress,
                    Postnummer = hittadPrenumerant.Postnummer,
                    Ort = hittadPrenumerant.Ort
                };
            }
            else
            {
                annonsor = foretagsModel;
            }

            await AnnonsService.SparaAnnonsAsync(annonsor, annonsForm);
            sparad = true;
            annonsForm = new();
            foretagsModel = new() { Typ = "foretag" };
            hittadPrenumerant = null;
            prenumerationsnummer = 0;
        }
        catch (Exception ex)
        {
            felmeddelande = $"Något gick fel: {ex.Message}";
        }
    }
}